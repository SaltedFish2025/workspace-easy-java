<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.easy.mapper.UserInfoMapper">
	<!--实体类映射-->
	<resultMap id="result_type" type="com.easy.entity.po.UserInfo">
		<!--用户id-->
		<id column="user_id" property="userId"/>
		<!--邮箱-->
		<result column="email" property="email"/>
		<!--昵称-->
		<result column="nick_name" property="nickName"/>
		<!--好友申请方式[0:无验证,1:同意后添加]-->
		<result column="join_type" property="joinType"/>
		<!--性别[0:男,1:女]-->
		<result column="sex" property="sex"/>
		<!--密码-->
		<result column="password" property="password"/>
		<!--个性签名-->
		<result column="personal_signature" property="personalSignature"/>
		<!--状态[]-->
		<result column="status" property="status"/>
		<!--创建时间-->
		<result column="create_time" property="createTime"/>
		<!--最后登录时间-->
		<result column="last_login_time" property="lastLoginTime"/>
		<!--最后登录地区-->
		<result column="area_name" property="areaName"/>
		<!--最后登录地区编号-->
		<result column="area_code" property="areaCode"/>
		<!--最后离线时间-->
		<result column="last_off_time" property="lastOffTime"/>
	</resultMap>

	<!-- __________________________________________段落sql__________________________________________ -->
	<!--可复用的常量绑定-->
	<sql id="bean_mapper_constants">
		<if test="_parameter != null">
			<bind name="queryKey" value="@com.easy.mapper.bean.BeanMapper@QUERY_FIELD_NAME"/>
			<bind name="beanKey" value="@com.easy.mapper.bean.BeanMapper@BEAN_FIELD_NAME"/>
			<bind name="listKey" value="@com.easy.mapper.bean.BeanMapper@LIST_FIELD_NAME"/>
			<bind name="idKey" value="@com.easy.mapper.bean.BeanMapper@ID_FIELD_NAME"/>
			<bind name="query" value="_parameter.containsKey(queryKey) ? _parameter.get(queryKey) : null"/>
			<bind name="bean" value="_parameter.containsKey(beanKey) ? _parameter.get(beanKey) : null"/>
			<bind name="list" value="_parameter.containsKey(listKey) ? _parameter.get(listKey) : null"/>
			<bind name="id" value="_parameter.containsKey(idKey) ? _parameter.get(idKey) : null"/>
		</if>
	</sql>

	<!--拓展条件查询-->
	<sql id="expand_condition_query">
		<include refid="bean_mapper_constants"/>
		<trim prefixOverrides="and">
			<if test="query.userIdFuzzy != null and query.userIdFuzzy != ''">
				and user_id &lt;= #{query.userIdFuzzy}
			</if>
			<if test="query.userIdList != null and query.userIdList.size() > 0 ">
				and user_id IN 
				<foreach collection="query.userIdList" item="id" open="(" separator="," close=")">
 					#{id}
				</foreach>
			</if>
			<if test="query.emailFuzzy != null and query.emailFuzzy != ''">
				and email &lt;= #{query.emailFuzzy}
			</if>
			<if test="query.emailList != null and query.emailList.size() > 0 ">
				and email IN 
				<foreach collection="query.emailList" item="id" open="(" separator="," close=")">
 					#{id}
				</foreach>
			</if>
			<if test="query.nickNameFuzzy != null and query.nickNameFuzzy != ''">
				and nick_name &lt;= #{query.nickNameFuzzy}
			</if>
			<if test="query.nickNameList != null and query.nickNameList.size() > 0 ">
				and nick_name IN 
				<foreach collection="query.nickNameList" item="id" open="(" separator="," close=")">
 					#{id}
				</foreach>
			</if>
			<if test="query.joinTypeStart != null">
				and join_type &gt;= #{query.joinTypeStart}
			</if>
			<if test="query.joinTypeEnd != null">
				and join_type &lt;= #{query.joinTypeEnd}
			</if>
			<if test="query.joinTypeList != null and query.joinTypeList.size() > 0 ">
				and join_type IN 
				<foreach collection="query.joinTypeList" item="id" open="(" separator="," close=")">
 					#{id}
				</foreach>
			</if>
			<if test="query.sexStart != null">
				and sex &gt;= #{query.sexStart}
			</if>
			<if test="query.sexEnd != null">
				and sex &lt;= #{query.sexEnd}
			</if>
			<if test="query.sexList != null and query.sexList.size() > 0 ">
				and sex IN 
				<foreach collection="query.sexList" item="id" open="(" separator="," close=")">
 					#{id}
				</foreach>
			</if>
			<if test="query.passwordFuzzy != null and query.passwordFuzzy != ''">
				and password &lt;= #{query.passwordFuzzy}
			</if>
			<if test="query.passwordList != null and query.passwordList.size() > 0 ">
				and password IN 
				<foreach collection="query.passwordList" item="id" open="(" separator="," close=")">
 					#{id}
				</foreach>
			</if>
			<if test="query.personalSignatureFuzzy != null and query.personalSignatureFuzzy != ''">
				and personal_signature &lt;= #{query.personalSignatureFuzzy}
			</if>
			<if test="query.personalSignatureList != null and query.personalSignatureList.size() > 0 ">
				and personal_signature IN 
				<foreach collection="query.personalSignatureList" item="id" open="(" separator="," close=")">
 					#{id}
				</foreach>
			</if>
			<if test="query.statusStart != null">
				and status &gt;= #{query.statusStart}
			</if>
			<if test="query.statusEnd != null">
				and status &lt;= #{query.statusEnd}
			</if>
			<if test="query.statusList != null and query.statusList.size() > 0 ">
				and status IN 
				<foreach collection="query.statusList" item="id" open="(" separator="," close=")">
 					#{id}
				</foreach>
			</if>
			<if test="query.createTimeStart != null">
				and create_time &gt;= #{query.createTimeStart, jdbcType=TIMESTAMP}
			</if>
			<if test="query.createTimeEnd != null">
				and create_time &lt;= #{query.createTimeEnd, jdbcType=TIMESTAMP}
			</if>
			<if test="query.createTimeList != null and query.createTimeList.size() > 0 ">
				and create_time IN 
				<foreach collection="query.createTimeList" item="id" open="(" separator="," close=")">
 					#{id}
				</foreach>
			</if>
			<if test="query.lastLoginTimeStart != null">
				and last_login_time &gt;= #{query.lastLoginTimeStart, jdbcType=TIMESTAMP}
			</if>
			<if test="query.lastLoginTimeEnd != null">
				and last_login_time &lt;= #{query.lastLoginTimeEnd, jdbcType=TIMESTAMP}
			</if>
			<if test="query.lastLoginTimeList != null and query.lastLoginTimeList.size() > 0 ">
				and last_login_time IN 
				<foreach collection="query.lastLoginTimeList" item="id" open="(" separator="," close=")">
 					#{id}
				</foreach>
			</if>
			<if test="query.areaNameFuzzy != null and query.areaNameFuzzy != ''">
				and area_name &lt;= #{query.areaNameFuzzy}
			</if>
			<if test="query.areaNameList != null and query.areaNameList.size() > 0 ">
				and area_name IN 
				<foreach collection="query.areaNameList" item="id" open="(" separator="," close=")">
 					#{id}
				</foreach>
			</if>
			<if test="query.areaCodeFuzzy != null and query.areaCodeFuzzy != ''">
				and area_code &lt;= #{query.areaCodeFuzzy}
			</if>
			<if test="query.areaCodeList != null and query.areaCodeList.size() > 0 ">
				and area_code IN 
				<foreach collection="query.areaCodeList" item="id" open="(" separator="," close=")">
 					#{id}
				</foreach>
			</if>
			<if test="query.lastOffTimeStart != null">
				and last_off_time &gt;= #{query.lastOffTimeStart}
			</if>
			<if test="query.lastOffTimeEnd != null">
				and last_off_time &lt;= #{query.lastOffTimeEnd}
			</if>
			<if test="query.lastOffTimeList != null and query.lastOffTimeList.size() > 0 ">
				and last_off_time IN 
				<foreach collection="query.lastOffTimeList" item="id" open="(" separator="," close=")">
 					#{id}
				</foreach>
			</if>
		</trim>
	</sql>

	<!--查询拓展功能-->
	<sql id="expand_expand_function">
		<include refid="bean_mapper_constants"/>
		<if test="query.order != null and query.order != ''">
			order by ${query.order}
		</if>
		<if test="query.pageOffset != null and query.pageSize != null">
			limit #{query.pageOffset},#{query.pageSize}
		</if>
	</sql>

	<!--裁剪字段赋值映射-->
	<sql id="trim_update_assignment">
		<include refid="bean_mapper_constants"/>
		<trim suffixOverrides=",">
			<if test="bean.nickName != null">nick_name=#{bean.nickName},</if>
			<if test="bean.joinType != null">join_type=#{bean.joinType},</if>
			<if test="bean.sex != null">sex=#{bean.sex},</if>
			<if test="bean.password != null">password=#{bean.password},</if>
			<if test="bean.personalSignature != null">personal_signature=#{bean.personalSignature},</if>
			<if test="bean.status != null">status=#{bean.status},</if>
			<if test="bean.createTime != null">create_time=#{bean.createTime},</if>
			<if test="bean.lastLoginTime != null">last_login_time=#{bean.lastLoginTime},</if>
			<if test="bean.areaName != null">area_name=#{bean.areaName},</if>
			<if test="bean.areaCode != null">area_code=#{bean.areaCode},</if>
			<if test="bean.lastOffTime != null">last_off_time=#{bean.lastOffTime},</if>
			user_id=user_id
		</trim>
	</sql>

	<!--裁剪insert字段-->
	<sql id="trim_all_field">
		<include refid="bean_mapper_constants"/>
		<trim suffixOverrides=",">
			user_id,
			email,
			nick_name,
			join_type,
			sex,
			password,
			personal_signature,
			status,
			create_time,
			last_login_time,
			area_name,
			area_code,
			last_off_time,
		</trim>
	</sql>

	<!--裁剪字段映射-->
	<sql id="trim_insert_field_mapping">
		<if test="!_parameter.containsKey(LIST_KEY)">
			<include refid="bean_mapper_constants"/>
		</if>
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<choose>
				<when test="bean.userId != null">#{bean.userId},</when>
				<otherwise>default,</otherwise>
			</choose>
			<choose>
				<when test="bean.email != null">#{bean.email},</when>
				<otherwise>default,</otherwise>
			</choose>
			<choose>
				<when test="bean.nickName != null">#{bean.nickName},</when>
				<otherwise>default,</otherwise>
			</choose>
			<choose>
				<when test="bean.joinType != null">#{bean.joinType},</when>
				<otherwise>default,</otherwise>
			</choose>
			<choose>
				<when test="bean.sex != null">#{bean.sex},</when>
				<otherwise>default,</otherwise>
			</choose>
			<choose>
				<when test="bean.password != null">#{bean.password},</when>
				<otherwise>default,</otherwise>
			</choose>
			<choose>
				<when test="bean.personalSignature != null">#{bean.personalSignature},</when>
				<otherwise>default,</otherwise>
			</choose>
			<choose>
				<when test="bean.status != null">#{bean.status},</when>
				<otherwise>default,</otherwise>
			</choose>
			<choose>
				<when test="bean.createTime != null">#{bean.createTime},</when>
				<otherwise>default,</otherwise>
			</choose>
			<choose>
				<when test="bean.lastLoginTime != null">#{bean.lastLoginTime},</when>
				<otherwise>default,</otherwise>
			</choose>
			<choose>
				<when test="bean.areaName != null">#{bean.areaName},</when>
				<otherwise>default,</otherwise>
			</choose>
			<choose>
				<when test="bean.areaCode != null">#{bean.areaCode},</when>
				<otherwise>default,</otherwise>
			</choose>
			<choose>
				<when test="bean.lastOffTime != null">#{bean.lastOffTime},</when>
				<otherwise>default,</otherwise>
			</choose>
		</trim>
	</sql>


	<!-- __________________________________________select__________________________________________ -->
	<!--根据条件集查询结果集-->
	<select id="selectList" resultMap="result_type" parameterType="com.easy.entity.query.UserInfoQuery">
		select 
		<include refid="trim_all_field"/>
		from user_info
		<where>
			<include refid="expand_condition_query"/>
		</where>
		<include refid="expand_expand_function"/>
	</select>

	<!--根据条件集查询总数-->
	<select id="selectCount" resultType="java.lang.Integer" parameterType="com.easy.entity.query.UserInfoQuery">
		select count(1) from user_info
		<where>
			<include refid="expand_condition_query"/>
		</where>
	</select>

	<!-- __________________________________________insert__________________________________________ -->
	<!--根据数据集插入数据-->
	<insert id="insert" parameterType="com.easy.entity.po.UserInfo" >
		insert into user_info ( 
		<include refid="trim_all_field"/>
		) values 
		<include refid="trim_insert_field_mapping"/>
	</insert>

	<!--根据数据集批量插入数据-->
	<insert id="insertBatch" >
		<include refid="bean_mapper_constants"/>
		insert into user_info ( 
		<include refid="trim_all_field"/>
		) values 
		<foreach collection="list" item="bean" separator="," >
			<include refid="trim_insert_field_mapping"/>
		</foreach>
	</insert>

	<!--根据数据集插入数据或修改[需有主键或唯一键]-->
	<insert id="insertOrUpdate" parameterType="com.easy.entity.po.UserInfo" >
		insert into user_info ( 
		<include refid="trim_all_field"/>
		) values 
		<include refid="trim_insert_field_mapping"/>
		on duplicate key update
		<include refid="trim_update_assignment"/>
	</insert>

	<!-- __________________________________________update__________________________________________ -->
	<!--根据条件集更新数据集[谨慎使用]-->
	<update id="updateByCondition">
		update user_info set
		<include refid="trim_update_assignment"/>
		where
		<include refid="expand_condition_query"/>
	</update>

	<!--根据id更新数据集-->
	<update id="updateById">
		<include refid="bean_mapper_constants"/>
		update user_info set
		<include refid="trim_update_assignment"/>
		where user_id = #{id}
	</update>

	<!-- __________________________________________delete__________________________________________ -->
	<!--根据条件集删除[谨慎使用]-->
	<delete id="deleteByCondition">
		delete from user_info
		where
		<include refid="expand_condition_query"/>
	</delete>

	<!--根据id删除数据集-->
	<delete id="deleteById">
		<include refid="bean_mapper_constants"/>
		delete
		from user_info
		where user_id in 
		<foreach collection="list" item="id" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>

</mapper>